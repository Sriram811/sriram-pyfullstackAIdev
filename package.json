{
  "name": "sriram-3d-workstation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "universe:build": "node scripts/build-universe.mjs",
    "predev": "node scripts/build-universe.mjs --if-missing",
    "dev": "vite",
    "build": "node scripts/build-universe.mjs && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify-dist.mjs",
    "test": "node --test tests/logic.test.mjs tests/data.test.mjs tests/assets.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "framer-motion": "11.11.17",
    "gsap": "3.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "vite": "5.4.10"
  }
}
